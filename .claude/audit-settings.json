{
  "disableSkillShellExecution": true,
  "enableArtifact": false,
  "crossSessionInbound": "refuse",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:agents.md)",
      "Edit(./reports/**)",
      "Edit(./state/sources-digest.md)"
    ],
    "deny": [
      "Bash",
      "WebSearch",
      "NotebookEdit",
      "Agent",
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "SendMessage",
      "ListAgents",
      "RemoteTrigger",
      "PushNotification",
      "CronCreate",
      "ScheduleWakeup",
      "DesignSync",
      "EnterWorktree",
      "Edit(./.claude/**)",
      "Edit(./audit.sh)",
      "Edit(./test/**)",
      "Edit(./prompts/**)",
      "Edit(./fixtures/**)",
      "Read(./fixtures/ledger-sync/**)",
      "Read(./fixtures/ledger-sync.expected.md)",
      "Read(./fixtures/harbor-notes/**)",
      "Read(./fixtures/harbor-notes.expected.md)",
      "Read(./reports/attack-coverage-*.md)",
      "Read(./reports/test-results-*-ledger-sync.md)",
      "Read(./reports/test-results-*-harbor-notes.md)",
      "Read(//**/.env*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  }
}
